#!/usr/bin/env bash
set -euo pipefail

# Verify the official FrankenPHP image pinned by the Dockerfile.
# Not a compiler: do not docker-build FrankenPHP, and do not treat a local
# frankenphp-php8.5.12:1.13.1 image as success.

IMG='dunglas/frankenphp:1.13.4-php8.5.12@sha256:c8abcc7925f16b1431f139d0410abe8f48db3fd862bacb646b05a4413337106a'

docker pull "$IMG"

docker run --rm --entrypoint php "$IMG" -r 'if (PHP_VERSION_ID !== 80512) { fwrite(STDERR, "PHP ".PHP_VERSION." is not 8.5.12\n"); exit(1); }'

docker run --rm --entrypoint frankenphp "$IMG" version | grep -F 'v1.13.4'

build_info="$(docker run --rm --entrypoint frankenphp "$IMG" build-info)"
# Toolchain line is "go<TAB>go1.27.3". Fail closed if it is missing.
go_line="$(printf '%s\n' "$build_info" | awk '$1 == "go" { print $2; exit }')"

if [[ ! "$go_line" =~ ^go([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    printf 'Go version missing or unparseable in frankenphp build-info (got %q)\n' "$go_line" >&2
    exit 1
fi

major="${BASH_REMATCH[1]}"
minor="${BASH_REMATCH[2]}"
patch="${BASH_REMATCH[3]}"

if ((major < 1 || (major == 1 && minor < 27) || (major == 1 && minor == 27 && patch < 3))); then
    printf 'Go %s is older than 1.27.3\n' "$go_line" >&2
    exit 1
fi

printf 'verified %s (PHP 8.5.12, FrankenPHP v1.13.4, %s)\n' "$IMG" "$go_line"
